# Contact form → automation webhook (Make.com, Zapier, …). Leave unset to
LEADS_WEBHOOK_URL=
PARTNERS_WEBHOOK_URL=
PARTNERS_WEBHOOK_SECRET=

# Careers form → automation webhook (Make.com → ClickUp). 
CAREERS_WEBHOOK_URL=
# Origin the per-client pages link to for [Terms URL] / [Privacy Policy URL].
# Defaults to https://heytruffle.ai; set it on dev so links stay on dev.
SITE_URL=
