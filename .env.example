# Copy to .env.local for local dev. In Render, set these under the
# service's Environment tab instead — .env.local is gitignored and never
# reaches the deployed build.

# --- Live demo assistant --------------------------------------------------
# Autocomplete backend (Step 1 of the demo integration). Client-side var
# (NEXT_PUBLIC_) — it ships in the browser bundle, matching how the demo
# backend is designed to be called directly from the browser.
NEXT_PUBLIC_DEMO_ASSISTANT_URL=https://landing-demo-assistant.onrender.com
# Required on every autocomplete request — issued per client by the demo
# backend. Missing/invalid → 401.
NEXT_PUBLIC_DEMO_ASSISTANT_API_KEY=
# Where a picked restaurant's placeId gets handed off to (Steps 2 & 3) —
# the demo app opens straight on that restaurant's confirmation screen.
NEXT_PUBLIC_DEMO_APP_URL=https://demo.heytruffle.ai

# --- Analytics: graph8 -----------------------------------------------------
# Public client-side write-key for the graph8 flow tracking pixel. It ships in
# the browser bundle by design (the pixel runs client-side), but is kept out of
# source so it can be rotated without a code change. Unset → the pixel is not
# loaded at all.
NEXT_PUBLIC_GRAPH8_WRITE_KEY=

# --- Analytics: reb2b -------------------------------------------------------
# Public client-side key for the reb2b visitor identification pixel. Unset →
# the pixel is not loaded at all.
NEXT_PUBLIC_REB2B_KEY=

# --- Analytics: Microsoft Clarity ------------------------------------------
# Project ID from Clarity project Settings > Overview. Ships in the browser
# bundle by design (Clarity.init runs client-side). Unset → Clarity is not
# initialized at all.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# --- Contact form ----------------------------------------------------------
# Automation webhook (Make.com, Zapier, …) that leads get forwarded to as
# { source, timestamp, data }. Leave unset to just log leads server-side.
LEADS_WEBHOOK_URL=
